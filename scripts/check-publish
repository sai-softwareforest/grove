#!/usr/bin/env bash
# Refuse a Grove revision that would publish secrets, credentials, agent
# session ids, or private machine-specific material. The tracked files of the
# revision and its commit message are both checked. Run against a git revision
# (default HEAD):
#
#   scripts/check-publish
#   scripts/check-publish HEAD
#
# Extra path prefixes to forbid are read from scripts/check-publish.local
# (gitignored). See scripts/check-publish.local.example.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
REV="${1:-HEAD}"
cd "$ROOT"

failed=0
hits() { printf '%s\n' "$@"; failed=1; }

# --- file names that must never be in the tree ---
while IFS= read -r path; do
  base="$(basename "$path")"
  case "$base" in
    .env|.env.*|*.pem|*.key|credentials.json|*.db|*.db-wal|*.db-shm|*.sqlite|*.sqlite3)
      hits "forbidden file in $REV: $path"
      ;;
  esac
  case "$path" in
    grove-data/*|.claude/*|LOCAL.md|scripts/check-publish.local)
      hits "forbidden file in $REV: $path"
      ;;
  esac
done < <(git ls-tree -r --name-only "$REV")

# --- secret-like content in tracked files ---
# Built so the script itself does not contain a live credential.
secret_re='(ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|gho_[A-Za-z0-9]{20,}|ghu_[A-Za-z0-9]{20,}|ghs_[A-Za-z0-9]{20,}|sk_live_[A-Za-z0-9]+|sk_test_[A-Za-z0-9]+|rk_live_[A-Za-z0-9]+|rk_test_[A-Za-z0-9]+|whsec_[A-Za-z0-9]+|xox[baprs]-[A-Za-z0-9-]+|AKIA[0-9A-Z]{16}|ASIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{35}|-----BEGIN ([A-Z]+ )?PRIVATE KEY-----|xai-[A-Za-z0-9_-]{20,}|sk-ant-[A-Za-z0-9_-]+|sk-proj-[A-Za-z0-9_-]+|postgres://[^[:space:]\"'\'']+:[^[:space:]\"'\'']+@|mysql://[^[:space:]\"'\'']+:[^[:space:]\"'\'']+@|mongodb(\+srv)?://[^[:space:]\"'\'']+:[^[:space:]\"'\'']+@)'

# git grep exits 1 when there are no matches; 0 when there are.
if matches="$(git grep -n -E -I "$secret_re" "$REV" -- ':!scripts/check-publish' 2>/dev/null || true)" && [[ -n "$matches" ]]; then
  hits "secret-like content in $REV:"
  printf '%s\n' "$matches"
fi

# --- agent session ids, in tracked files and in the commit message ---
# A session id or a link to a session names a private conversation. Agent
# tools add such a line to commit messages by default, which is why the
# message is read too. Written so this script does not match itself.
session_re='session_[0-9A-Za-z]{20,}'

if matches="$(git grep -n -E -I "$session_re" "$REV" -- ':!scripts/check-publish' 2>/dev/null || true)" && [[ -n "$matches" ]]; then
  hits "agent session id in $REV:"
  printf '%s\n' "$matches"
fi

# A revision that is not a commit (a tree, say) has no message to read.
message="$(git log -1 --format=%B "$REV" 2>/dev/null || true)"
if matches="$(printf '%s\n' "$message" | grep -n -E "$secret_re|$session_re" || true)" && [[ -n "$matches" ]]; then
  hits "secret-like content or agent session id in the commit message of $REV:"
  printf '%s\n' "$matches"
fi

# --- optional local private-path prefixes ---
local_file="$ROOT/scripts/check-publish.local"
if [[ -f "$local_file" ]]; then
  while IFS= read -r raw || [[ -n "$raw" ]]; do
    pattern="${raw%%#*}"
    pattern="${pattern%"${pattern##*[![:space:]]}"}"
    pattern="${pattern#"${pattern%%[![:space:]]*}"}"
    [[ -z "$pattern" ]] && continue
    # Search the revision's tracked files only. Escape for extended regex.
    escaped="$(printf '%s' "$pattern" | sed -e 's/[.[\*^$()+?{|]/\\&/g')"
    if matches="$(git grep -n -E -I -F "$pattern" "$REV" -- 2>/dev/null || true)" && [[ -n "$matches" ]]; then
      hits "private path pattern found in $REV:"
      printf '%s\n' "$matches"
    fi
    unset escaped
  done < "$local_file"
fi

if [[ "$failed" -ne 0 ]]; then
  echo "check-publish: failed. Nothing should be pushed until this is clean." >&2
  exit 1
fi

echo "check-publish: $REV is clean."
exit 0
